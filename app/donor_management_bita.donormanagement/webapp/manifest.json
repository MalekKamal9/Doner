{
  "_version": "1.60.0",
  "sap.app": {
    "id": "donormanagementbita.donormanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.0",
      "toolsId": "9b73f1db-f622-4c3b-9e94-b46775025f56"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/donor_management_Bita/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "donormanagementbitadonormanagement-display": {
          "semanticObject": "donormanagementbitadonormanagement",
          "action": "display",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      },
      "outbounds": {
        "navigateToDashboard": {
          "semanticObject": "donormanagementbitadashboard",
          "action": "display",
          "parameters": {
            "preferredMode": []
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://customer",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.13",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.uxap": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "donormanagementbita.donormanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "DonorsList",
          "target": "DonorsList"
        },
        {
          "pattern": "Donors({key}):?query:",
          "name": "DonorsObjectPage",
          "target": "DonorsObjectPage"
        }
      ],
      "targets": {
        "DonorsList": {
          "type": "Component",
          "id": "DonorsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Donors",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Donors": {
                  "detail": {
                    "route": "DonorsObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "AnalyticsDashboard": {
                      "press": "donormanagementbita.donormanagement.ext.ListReportExt.onOpenAnalytics",
                      "text": "📊 Analytics Dashboard",
                      "enabled": true,
                      "visible": true
                    }
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi",
                    "condensedTableLayout": false,
                    "enableExport": true,
                    "enableFullScreen": true,
                    "quickVariantSelection": {
                      "showCounts": true
                    },
                    "personalization": {
                      "column": true,
                      "filter": true,
                      "sort": true,
                      "group": true
                    }
                  }
                }
              }
            }
          }
        },
        "DonorsObjectPage": {
          "type": "Component",
          "id": "DonorsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Donors",
              "sectionLayout": "Tabs",
              "showRelatedApps": false,
              "content": {
                "body": {
                  "sections": {
                    "CustomAnalytics": {
                      "template": "donormanagementbita.donormanagement.ext.fragment.DonorAnalytics",
                      "position": {
                        "placement": "After",
                        "anchor": "Analytics"
                      },
                      "title": "📊 Visual Analytics",
                      "type": "XMLFragment"
                    }
                  }
                }
              },
              "controlConfiguration": {
                "donations/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "creationMode": {
                      "name": "Inline"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#donormanagementbita.donormanagement::DonorsObjectPage": {
            "controllerName": "donormanagementbita.donormanagement.ext.controller.ObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "donormanagementbita"
  }
}